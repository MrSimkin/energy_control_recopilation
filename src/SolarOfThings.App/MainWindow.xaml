<Window x:Class="SolarOfThings.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Window.Title}"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#C2C7D0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F474E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#343A40">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#2B3035" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Brand.Title}" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Brand.Subtitle}" Foreground="#ADB5BD" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,12,0,0">
                    <Button x:Name="DashboardNav" Style="{StaticResource SidebarButtonStyle}" Tag="Dashboard" Click="Navigation_Click" Content="{DynamicResource Nav.Dashboard}"/>
                    <Button x:Name="AnalysisNav" Style="{StaticResource SidebarButtonStyle}" Tag="Analysis" Click="Navigation_Click" Content="{DynamicResource Nav.Analysis}"/>
                    <Button x:Name="BatteryNav" Style="{StaticResource SidebarButtonStyle}" Tag="Battery" Click="Navigation_Click" Content="{DynamicResource Nav.Battery}"/>
                    <Button x:Name="GridUtilityNav" Style="{StaticResource SidebarButtonStyle}" Tag="GridUtility" Click="Navigation_Click" Content="{DynamicResource Nav.GridUtility}"/>
                    <Button x:Name="ReportsNav" Style="{StaticResource SidebarButtonStyle}" Tag="Reports" Click="Navigation_Click" Content="{DynamicResource Nav.Reports}"/>
                    <Button x:Name="DataNav" Style="{StaticResource SidebarButtonStyle}" Tag="Data" Click="Navigation_Click" Content="{DynamicResource Nav.Data}"/>
                    <Button x:Name="DiagnosticsNav" Style="{StaticResource SidebarButtonStyle}" Tag="Diagnostics" Click="Navigation_Click" Content="{DynamicResource Nav.Diagnostics}"/>
                    <Button x:Name="SettingsNav" Style="{StaticResource SidebarButtonStyle}" Tag="Settings" Click="Navigation_Click" Content="{DynamicResource Nav.Settings}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="{DynamicResource Page.Dashboard.Title}" FontSize="18" FontWeight="SemiBold" Foreground="#343A40"/>
                        <TextBlock x:Name="PageSubtitle" Text="{DynamicResource Page.Dashboard.Subtitle}" FontSize="11" Foreground="#6C757D"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{DynamicResource Language.Label}" VerticalAlignment="Center" Foreground="#6C757D" Margin="0,0,8,0"/>
                        <ComboBox x:Name="LanguageSelector"
                                  Width="105"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="LanguageSelector_SelectionChanged">
                            <ComboBoxItem Tag="es" Content="{DynamicResource Language.Spanish}"/>
                            <ComboBoxItem Tag="en" Content="{DynamicResource Language.English}"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Padding="18,8"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Background="#28A745"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="UpdateData_Click"
                            Content="{DynamicResource Action.UpdateData}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="DashboardContent" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource Dashboard.Overview}" FontSize="21" FontWeight="SemiBold" Foreground="#343A40" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" BorderBrush="#17A2B8" BorderThickness="4,1,1,1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Metric.PvPower}" Foreground="#6C757D" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="— kW" Foreground="#343A40" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <TextBlock Text="{DynamicResource Metric.AwaitingSync}" Foreground="#ADB5BD" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" BorderBrush="#28A745" BorderThickness="4,1,1,1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Metric.HouseLoad}" Foreground="#6C757D" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="— kW" Foreground="#343A40" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <TextBlock Text="{DynamicResource Metric.AwaitingSync}" Foreground="#ADB5BD" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" BorderBrush="#FFC107" BorderThickness="4,1,1,1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Metric.BatterySoc}" Foreground="#6C757D" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="— %" Foreground="#343A40" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <TextBlock Text="{DynamicResource Metric.ConfiguredCapacity}" Foreground="#ADB5BD" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="0" BorderBrush="#6C757D" BorderThickness="4,1,1,1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Metric.GridImport}" Foreground="#6C757D" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="— kW" Foreground="#343A40" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <TextBlock Text="{DynamicResource Metric.AwaitingSync}" Foreground="#ADB5BD" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                                <StackPanel>
                                    <Border BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="16,12">
                                        <TextBlock Text="{DynamicResource Dashboard.EnergyOverview}" FontSize="15" FontWeight="SemiBold" Foreground="#343A40"/>
                                    </Border>
                                    <Grid Height="320">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Dashboard.ChartArea}" FontSize="18" Foreground="#6C757D" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Dashboard.ChartPending}"
                                                       Margin="0,8,0,0"
                                                       Foreground="#ADB5BD"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       MaxWidth="430"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0" Padding="0">
                                <StackPanel>
                                    <Border BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="16,12">
                                        <TextBlock Text="{DynamicResource Dashboard.SystemStatus}" FontSize="15" FontWeight="SemiBold" Foreground="#343A40"/>
                                    </Border>
                                    <StackPanel Margin="16">
                                        <TextBlock Text="{DynamicResource Status.SolarOfThings}" Foreground="#6C757D"/>
                                        <TextBlock x:Name="SolarStatusText" Text="{DynamicResource Status.NotConnected}" FontWeight="SemiBold" Foreground="#DC3545" Margin="0,2,0,6"/>
                                        <Button Content="{DynamicResource Commissioning.ConnectButton}"
                                                Padding="10,5"
                                                Margin="0,0,0,14"
                                                HorizontalAlignment="Left"
                                                Click="ConnectSolar_Click"/>
                                        <TextBlock Text="{DynamicResource Status.LocalDatabase}" Foreground="#6C757D"/>
                                        <TextBlock Text="{DynamicResource Status.Ready}" FontWeight="SemiBold" Foreground="#28A745" Margin="0,2,0,14"/>
                                        <TextBlock Text="{DynamicResource Status.LastUpdate}" Foreground="#6C757D"/>
                                        <TextBlock x:Name="LastUpdatedText" Text="{DynamicResource Status.Never}" FontWeight="SemiBold" Foreground="#343A40" Margin="0,2,0,10"/>

                                        <TextBlock Text="{DynamicResource DataSync.StartModeLabel}" Foreground="#6C757D"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                            <ComboBox x:Name="CaptureStartModeSelector"
                                                      Width="190"
                                                      SelectedValuePath="Tag"
                                                      SelectionChanged="CaptureStartModeSelector_SelectionChanged">
                                                <ComboBoxItem Tag="auto" Content="{DynamicResource DataSync.StartModeAuto}"/>
                                                <ComboBoxItem Tag="manual" Content="{DynamicResource DataSync.StartModeManual}"/>
                                            </ComboBox>
                                            <DatePicker x:Name="ManualCaptureStartDatePicker"
                                                        Width="135"
                                                        Margin="8,0,0,0"
                                                        IsEnabled="False"/>
                                        </StackPanel>
                                        <TextBlock x:Name="CaptureStartHintText"
                                                   Foreground="#6C757D"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>

                                        <TextBlock x:Name="HistorySyncProgressLabel"
                                                   Text="{DynamicResource Status.SyncProgress}"
                                                   Foreground="#6C757D"
                                                   Visibility="Collapsed"/>
                                        <ProgressBar x:Name="HistorySyncProgressBar"
                                                     Height="14"
                                                     Minimum="0"
                                                     Maximum="1"
                                                     Value="0"
                                                     Margin="0,4,0,6"
                                                     Visibility="Collapsed"/>
                                        <TextBlock x:Name="HistorySyncProgressText"
                                                   Foreground="#6C757D"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Visibility="Collapsed"/>
                                        <Button x:Name="StopHistorySyncButton"
                                                Content="{DynamicResource Action.StopSync}"
                                                Padding="10,5"
                                                Margin="0,7,0,14"
                                                HorizontalAlignment="Left"
                                                Visibility="Collapsed"
                                                Click="StopHistorySync_Click"/>

                                        <TextBlock Text="{DynamicResource Status.Phase}" Foreground="#6C757D"/>
                                        <TextBlock Text="{DynamicResource Status.Phase3}" FontWeight="SemiBold" Foreground="#343A40" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="PlaceholderContent" Visibility="Collapsed" Margin="20">
                    <Border Style="{StaticResource CardStyle}" Margin="0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
                            <TextBlock Text="{DynamicResource Placeholder.Heading}" FontSize="13" Foreground="#6C757D" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PlaceholderTitle" FontSize="26" FontWeight="SemiBold" Foreground="#343A40" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PlaceholderDescription" FontSize="14" Foreground="#6C757D" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Placeholder.NoFakeData}" FontSize="12" Foreground="#ADB5BD" Margin="0,20,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            <StackPanel x:Name="ConnectionToolsPanel"
                                        Visibility="Collapsed"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,22,0,0">
                                <Button Content="{DynamicResource Commissioning.ConnectButton}"
                                        Padding="12,6"
                                        Click="ConnectSolar_Click"/>
                                <Button Content="{DynamicResource Diagnostics.OpenWindow}"
                                        Padding="12,6"
                                        Margin="8,0,0,0"
                                        Click="OpenDiagnostics_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="White" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Status.Database}" Foreground="#6C757D" FontSize="10" Margin="0,0,4,0"/>
                        <TextBlock x:Name="DatabasePathText"
                                   Foreground="#6C757D"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="#6C757D"
                               FontSize="10"
                               Text="{DynamicResource Status.SpecFrozen}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
