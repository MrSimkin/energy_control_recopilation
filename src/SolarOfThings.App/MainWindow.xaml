<Window x:Class="SolarOfThings.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:controls="clr-namespace:SolarOfThings.App.Controls"
        Title="{DynamicResource Window.Title}"
        Width="1440"
        Height="820"
        MinWidth="1120"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        SizeChanged="MainWindow_SizeChanged">
    <Window.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#C2C7D0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F474E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarGroupHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B9C3CD"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="22,15,8,5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="BorderBrush" Value="#E1E5EA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="WorkspaceSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5F6B76"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#263238"/>
        </Style>
        <Style x:Key="HelperTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6C757D"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="InfoStatusBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F2F8FD"/>
            <Setter Property="BorderBrush" Value="#CFE4F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="11,8"/>
        </Style>
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0B6ECA"/>
            <Setter Property="BorderBrush" Value="#0B6ECA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder"
                                        Property="Background"
                                        Value="#075BAA"/>
                                <Setter TargetName="ActionBorder"
                                        Property="BorderBrush"
                                        Value="#075BAA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder"
                                        Property="Opacity"
                                        Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBorder"
                                        Property="Opacity"
                                        Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#343A40"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D0D7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder"
                                        Property="Background"
                                        Value="#F2F5F8"/>
                                <Setter TargetName="ActionBorder"
                                        Property="BorderBrush"
                                        Value="#AEB8C2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder"
                                        Property="Opacity"
                                        Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBorder"
                                        Property="Opacity"
                                        Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DestructiveActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryActionButtonStyle}">
            <Setter Property="Foreground" Value="#A71D2A"/>
            <Setter Property="BorderBrush" Value="#E2B8BD"/>
            <Setter Property="Background" Value="#FFF9FA"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE3E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF0F3"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F6F9"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="BorderBrush" Value="#DDE3E9"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8F3FE"/>
                    <Setter Property="Foreground" Value="#1F2D3D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PageTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="PageTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#6C757D"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#007BFF"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="#007BFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8F9FA"/>
                                <Setter Property="Foreground" Value="#343A40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LiveCountdownStyle" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="2"/>
            <Setter Property="Background" Value="#E9ECEF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Background="{TemplateBinding Background}"
                              ClipToBounds="True">
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#343A40">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#2B3035" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Brand.Title}" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Brand.Subtitle}" Foreground="#ADB5BD" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Always-scrollable sidebar; named navigation buttons and existing routes are preserved. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="0,8,0,12">
                        <TextBlock Style="{StaticResource SidebarGroupHeadingStyle}" Text="{DynamicResource Nav.Group.Home}"/>
                        <Button x:Name="DashboardNav" Style="{StaticResource SidebarButtonStyle}" Tag="Dashboard" Click="Navigation_Click" Content="{DynamicResource Nav.Dashboard}"/>
                        <TextBlock Style="{StaticResource SidebarGroupHeadingStyle}" Text="{DynamicResource Nav.Group.Energy}"/>
                        <Button x:Name="AnalysisNav" Style="{StaticResource SidebarButtonStyle}" Tag="Analysis" Click="Navigation_Click" Content="{DynamicResource Nav.Analysis}"/>
                        <Button x:Name="BatteryNav" Style="{StaticResource SidebarButtonStyle}" Tag="Battery" Click="Navigation_Click" Content="{DynamicResource Nav.Battery}"/>
                        <Button x:Name="GridUtilityNav" Style="{StaticResource SidebarButtonStyle}" Tag="GridUtility" Click="Navigation_Click" Content="{DynamicResource Nav.GridUtility}"/>
                        <TextBlock Style="{StaticResource SidebarGroupHeadingStyle}" Text="{DynamicResource Nav.Group.Reports}"/>
                        <Button x:Name="ReportsNav" Style="{StaticResource SidebarButtonStyle}" Tag="Reports" Click="Navigation_Click" Content="{DynamicResource Nav.Reports}"/>
                        <TextBlock Style="{StaticResource SidebarGroupHeadingStyle}" Text="{DynamicResource Nav.Group.DataTools}"/>
                        <Button x:Name="DataNav" Style="{StaticResource SidebarButtonStyle}" Tag="Data" Click="Navigation_Click" Content="{DynamicResource Nav.Data}"/>
                        <Button x:Name="BackupNav" Style="{StaticResource SidebarButtonStyle}" Tag="Backup" Click="Navigation_Click" Content="{DynamicResource Nav.Backup}"/>
                        <TextBlock Style="{StaticResource SidebarGroupHeadingStyle}" Text="{DynamicResource Nav.Group.System}"/>
                        <Button x:Name="SettingsNav" Style="{StaticResource SidebarButtonStyle}" Tag="Settings" Click="Navigation_Click" Content="{DynamicResource Nav.Settings}"/>
                        <Button x:Name="DiagnosticsNav" Style="{StaticResource SidebarButtonStyle}" Tag="Diagnostics" Click="Navigation_Click" Content="{DynamicResource Nav.Diagnostics}"/>
                        <Button x:Name="HelpNav" Style="{StaticResource SidebarButtonStyle}" Tag="Help" Click="Navigation_Click" Content="{DynamicResource Nav.Help}"/>
                        <Button x:Name="AboutNav" Style="{StaticResource SidebarButtonStyle}" Tag="About" Click="Navigation_Click" Content="{DynamicResource Nav.About}"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="{DynamicResource Page.Dashboard.Title}" FontSize="18" FontWeight="SemiBold" Foreground="#343A40"/>
                        <TextBlock x:Name="PageSubtitle" Text="{DynamicResource Page.Dashboard.Subtitle}" FontSize="11" Foreground="#6C757D"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{DynamicResource Language.Label}" VerticalAlignment="Center" Foreground="#6C757D" Margin="0,0,8,0"/>
                        <ComboBox x:Name="LanguageSelector"
                                  Width="105"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="LanguageSelector_SelectionChanged">
                            <ComboBoxItem Tag="es" Content="{DynamicResource Language.Spanish}"/>
                            <ComboBoxItem Tag="en" Content="{DynamicResource Language.English}"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Style="{StaticResource PrimaryActionButtonStyle}" Grid.Column="2"
                            Padding="18,8"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Background="#28A745"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="{DynamicResource Tooltip.UpdateData}"
                            Click="UpdateData_Click"
                            Content="{DynamicResource Action.UpdateData}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="DashboardContent" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PageScrollViewer_PreviewMouseWheel">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource Dashboard.Overview}" FontSize="21" FontWeight="SemiBold" Foreground="#343A40"/>
                        <TextBlock x:Name="DashboardFreshnessText"
                                   Text=""
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#6C757D"
                                   Margin="0,4,0,14"
                                   TextWrapping="Wrap"/>

                        <Grid x:Name="DashboardSummaryCards" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" BorderBrush="#17A2B8" BorderThickness="4,1,1,1" ToolTip="{DynamicResource Tooltip.PvPower}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="{DynamicResource Metric.PvPower}" Foreground="#6C757D" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="PvPowerValueText" Text="— kW" Foreground="#343A40" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="PvPowerMetaText" Text="{DynamicResource Metric.AwaitingSync}" Foreground="#6C757D" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="PvLiveCountdown"
                                                 Grid.Row="1"
                                                 Style="{StaticResource LiveCountdownStyle}"
                                                 Foreground="#17A2B8"
                                                 Margin="-18,12,-18,-18"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" BorderBrush="#28A745" BorderThickness="4,1,1,1" ToolTip="{DynamicResource Tooltip.HouseLoad}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="{DynamicResource Metric.HouseLoad}" Foreground="#6C757D" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="HouseLoadValueText" Text="— kW" Foreground="#343A40" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="HouseLoadMetaText" Text="{DynamicResource Metric.AwaitingSync}" Foreground="#6C757D" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="HouseLiveCountdown"
                                                 Grid.Row="1"
                                                 Style="{StaticResource LiveCountdownStyle}"
                                                 Foreground="#28A745"
                                                 Margin="-18,12,-18,-18"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" BorderBrush="#FFC107" BorderThickness="4,1,1,1" ToolTip="{DynamicResource Tooltip.BatterySoc}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="{DynamicResource Metric.BatterySoc}" Foreground="#6C757D" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="BatterySocValueText" Text="— %" Foreground="#343A40" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="BatterySocMetaText" Text="{DynamicResource Metric.ConfiguredCapacity}" Foreground="#6C757D" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="BatteryLiveCountdown"
                                                 Grid.Row="1"
                                                 Style="{StaticResource LiveCountdownStyle}"
                                                 Foreground="#FFC107"
                                                 Margin="-18,12,-18,-18"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="0" BorderBrush="#6C757D" BorderThickness="4,1,1,1" ToolTip="{DynamicResource Tooltip.GridImport}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="{DynamicResource Metric.GridImport}" Foreground="#6C757D" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="GridImportValueText" Text="— kW" Foreground="#343A40" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="GridImportMetaText" Text="{DynamicResource Metric.AwaitingSync}" Foreground="#6C757D" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="GridLiveCountdown"
                                                 Grid.Row="1"
                                                 Style="{StaticResource LiveCountdownStyle}"
                                                 Foreground="#6C757D"
                                                 Margin="-18,12,-18,-18"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                                <StackPanel>
                                    <Border BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="16,12">
                                        <TextBlock Text="{DynamicResource Dashboard.EnergyOverview}" FontSize="15" FontWeight="SemiBold" Foreground="#343A40"/>
                                    </Border>
                                    <Border Background="#F8F9FA"
                                            BorderBrush="#DEE2E6"
                                            BorderThickness="0,0,0,1"
                                            Padding="16,12">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Dashboard.OperatingState}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#6C757D"/>
                                            <TextBlock x:Name="OperatingStateText"
                                                       Text="{DynamicResource Operating.NO_DATA}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="#343A40"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0"/>
                                            <TextBlock x:Name="OperatingStateMetaText"
                                                       Text=""
                                                       FontSize="11"
                                                       Foreground="#6C757D"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Margin="16"
                                                ToolTip="{DynamicResource Tooltip.DashboardLatestDay}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource Dashboard.LatestDayHeading}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Foreground="#343A40"
                                                       VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource SecondaryActionButtonStyle}" Grid.Column="1"
                                                    Content="{DynamicResource Dashboard.OpenHistory}"
                                                    Tag="Analysis"
                                                    Padding="10,5"
                                                    Margin="12,0,0,0"
                                                    Click="Navigation_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="DashboardLatestDayDateText"
                                                   Text="{DynamicResource Dashboard.LatestDayNoData}"
                                                   FontSize="12"
                                                   Foreground="#6C757D"
                                                   Margin="0,4,0,12"
                                                   TextWrapping="Wrap"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{DynamicResource Dashboard.LatestDaySolar}"
                                                           FontSize="12"
                                                           Foreground="#6C757D"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock x:Name="DashboardLatestDaySolarText"
                                                           Text="— kWh"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Text="{DynamicResource Dashboard.LatestDayHouse}"
                                                           FontSize="12"
                                                           Foreground="#6C757D"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock x:Name="DashboardLatestDayHouseText"
                                                           Text="— kWh"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                                <TextBlock Text="{DynamicResource Dashboard.LatestDayGrid}"
                                                           FontSize="12"
                                                           Foreground="#6C757D"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock x:Name="DashboardLatestDayGridText"
                                                           Text="— kWh"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="{DynamicResource Dashboard.LatestDayCoverage}"
                                                           FontSize="12"
                                                           Foreground="#6C757D"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock x:Name="DashboardLatestDayCoverageText"
                                                           Text="— %"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

