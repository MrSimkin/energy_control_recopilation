                            <StackPanel>
                                <TextBlock Text="{DynamicResource Backup.WeeklyHeading}" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Backup.WeeklyInfo}" Foreground="#6C757D"
                                           FontSize="12" Margin="0,5,0,10" TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <Button Content="{DynamicResource Backup.CreateNow}" Padding="12,8"
                                            Click="BackupPageCreate_Click" Margin="0,0,8,8"/>
                                    <Button Content="{DynamicResource Backup.DestinationSettings}" Padding="12,8"
                                            Click="BackupPageSettings_Click" Margin="0,0,8,8"/>
                                    <Button Content="{DynamicResource Backup.OpenLocal}" Padding="12,8"
                                            Click="BackupPageOpenFolder_Click" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Backup.InventoryHeading}" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Backup.InventoryIntro}" Foreground="#6C757D"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button x:Name="BackupRefreshButton" Content="{DynamicResource Backup.Refresh}"
                                            Padding="12,7" Click="BackupPageRefresh_Click" Margin="0,0,8,8"/>
                                    <Button x:Name="BackupVerifyButton" Content="{DynamicResource Backup.Verify}"
                                            Padding="12,7" Click="BackupPageVerify_Click" Margin="0,0,8,8"/>
                                    <Button x:Name="BackupDeleteButton" Content="{DynamicResource Backup.DeleteSelected}"
                                            Style="{StaticResource DestructiveActionButtonStyle}"
                                            Padding="12,7" Click="BackupPageDelete_Click" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <ProgressBar x:Name="BackupInventoryProgress" IsIndeterminate="True"
                                             Height="7" Margin="0,0,0,10" Visibility="Collapsed"/>
                                <DataGrid x:Name="BackupInventoryGrid" AutoGenerateColumns="False"
                                          IsReadOnly="True" SelectionMode="Single"
                                          Height="305" HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{DynamicResource Backup.ColumnLocation}" Binding="{Binding Location}" Width="100"/>
                                        <DataGridTextColumn Header="{DynamicResource Backup.ColumnName}" Binding="{Binding Name}" Width="275"/>
                                        <DataGridTextColumn Header="{DynamicResource Backup.ColumnKind}" Binding="{Binding Kind}" Width="145"/>
                                        <DataGridTextColumn Header="{DynamicResource Backup.ColumnDate}" Binding="{Binding ModifiedUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="145"/>
                                        <DataGridTextColumn Header="{DynamicResource Backup.ColumnSize}" Binding="{Binding SizeBytes, StringFormat=N0}" Width="115"/>
                                        <DataGridTextColumn Header="{DynamicResource Backup.ColumnStatus}" Binding="{Binding VerificationStatus}" Width="125"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="BackupInventoryStatusText" FontSize="12"
                                           Foreground="#495057" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                <TextBlock Text="{DynamicResource Backup.LastCopyPolicy}" Foreground="#6C757D"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PageScrollViewer_PreviewMouseWheel">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource Settings.Heading}" FontSize="21" FontWeight="SemiBold" Foreground="#343A40"/>
                        <TextBlock Text="{DynamicResource Settings.Intro}" FontSize="13" Foreground="#6C757D" Margin="0,5,0,16" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource CardStyle}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings.ConnectionHeading}" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SettingsSessionStatusText" Text="{DynamicResource Settings.SessionNotRemembered}" FontSize="13" FontWeight="SemiBold" Foreground="#6C757D" Margin="0,8,0,12" TextWrapping="Wrap"/>
                                <CheckBox x:Name="AutoConnectCheckBox" Content="{DynamicResource Settings.AutoConnect}" Click="AutoConnectCheckBox_Click"/>
                                <TextBlock Text="{DynamicResource Settings.AutoConnectHint}" FontSize="12" Foreground="#6C757D" Margin="22,4,0,14" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{DynamicResource Commissioning.ConnectButton}" Padding="12,6" Click="SettingsConnect_Click"/>
                                    <Button Style="{StaticResource DestructiveActionButtonStyle}" Content="{DynamicResource Settings.ForgetCredentials}" Padding="12,6" Margin="8,0,0,0" Click="SettingsForgetSession_Click"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Settings.PasswordPrivacy}" FontSize="11" Foreground="#6C757D" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings.ExportFolderHeading}" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Settings.ExportFolderDescription}" FontSize="12" Foreground="#6C757D" Margin="0,5,0,8" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SettingsExportFolderText" TextWrapping="Wrap" FontSize="13" Foreground="#343A40" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{DynamicResource Settings.ChooseExportFolder}" Click="SettingsChooseExportFolder_Click" Padding="12,6"/>
                                    <Button Content="{DynamicResource Settings.ResetExportFolder}" Style="{StaticResource SecondaryActionButtonStyle}"
                                            Click="SettingsResetExportFolder_Click" Padding="12,6" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings.BackupHeading}" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Settings.BackupDescription}" FontSize="12" Foreground="#6C757D" TextWrapping="Wrap" Margin="0,5,0,10"/>
                                <TextBlock Text="{DynamicResource Settings.BackupSecondLocation}" FontSize="13"
                                           FontWeight="SemiBold" Margin="0,5,0,4"/>
                                <TextBlock x:Name="SettingsBackupSecondaryFolderText" FontSize="12"
                                           TextWrapping="Wrap" Foreground="#495057" Margin="0,0,0,8"/>
                                <Button Content="{DynamicResource Settings.BackupChooseSecondary}" HorizontalAlignment="Left"
                                        Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,0,12"
                                        Click="SettingsBackupChooseSecondary_Click"/>
                                <TextBlock x:Name="SettingsBackupInventoryText" FontSize="12"
                                           TextWrapping="Wrap" Foreground="#495057" Margin="0,0,0,10"/>
                                <Button x:Name="SettingsBackupNowButton" HorizontalAlignment="Left"
                                        Content="{DynamicResource Settings.BackupNow}" Padding="14,7"
                                        Click="SettingsBackupNow_Click"/>
                                <ProgressBar x:Name="SettingsBackupProgressBar" Visibility="Collapsed"
                                             IsIndeterminate="True" Height="8" Margin="0,10,0,5"/>
                                <TextBlock x:Name="SettingsBackupStatusText" FontSize="12" Foreground="#495057"
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="HelpContent"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="PageScrollViewer_PreviewMouseWheel">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource Help.Heading}"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="#343A40"/>
                        <TextBlock Text="{DynamicResource Help.Intro}"
                                   FontSize="13"
                                   Foreground="#6C757D"
                                   Margin="0,5,0,16"
                                   TextWrapping="Wrap"/>
                        <Border Style="{StaticResource CardStyle}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Help.SelectSection}"
                                           FontSize="12"
                                           Foreground="#6C757D"/>
                                <ComboBox x:Name="HelpSectionSelector"
                                          Width="420"
                                          HorizontalAlignment="Left"
                                          Margin="0,5,0,12"
                                          DisplayMemberPath="Title"
                                          SelectedValuePath="Id"
                                          SelectionChanged="HelpSectionSelector_SelectionChanged"/>
                                <TextBlock x:Name="HelpSectionBodyText"
                                           FontSize="13"
                                           Foreground="#343A40"
                                           TextWrapping="Wrap"
                                           LineHeight="20"/>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Style="{StaticResource SecondaryActionButtonStyle}" Content="{DynamicResource Help.ExportSection}"
                                            Padding="12,6"
                                            Click="HelpExportSection_Click"/>
                                    <Button Style="{StaticResource PrimaryActionButtonStyle}" Content="{DynamicResource Help.ExportAll}"
                                            Padding="12,6"
                                            Margin="8,0,0,0"
                                            Click="HelpExportAll_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="HelpExportStatusText"
                                           FontSize="12"
                                           Foreground="#6C757D"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AboutContent"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="PageScrollViewer_PreviewMouseWheel">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource About.Heading}"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="#343A40"/>
                        <TextBlock Text="{DynamicResource About.Intro}"
                                   FontSize="13"
                                   Foreground="#6C757D"
                                   Margin="0,5,0,16"
                                   TextWrapping="Wrap"/>
                        <Border Style="{StaticResource CardStyle}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource About.VersionLabel}"
                                           FontSize="12"
                                           Foreground="#6C757D"/>
                                <TextBlock x:Name="AboutVersionText"
                                           Text="—"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#343A40"
                                           Margin="0,4,0,14"/>
                                <Button Style="{StaticResource SecondaryActionButtonStyle}" Content="{DynamicResource About.WhatsNew}"
                                        Padding="12,6"
                                        HorizontalAlignment="Left"
                                        Click="AboutWhatsNew_Click"/>
                                <TextBlock Text="{DynamicResource About.VersionHint}"
                                           FontSize="11"
                                           Foreground="#6C757D"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="PlaceholderContent" Visibility="Collapsed" Margin="20">
                    <Border Style="{StaticResource CardStyle}" Margin="0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
                            <TextBlock Text="{DynamicResource Placeholder.Heading}" FontSize="13" Foreground="#6C757D" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PlaceholderTitle" FontSize="26" FontWeight="SemiBold" Foreground="#343A40" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PlaceholderDescription" FontSize="14" Foreground="#6C757D" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Placeholder.NoFakeData}" FontSize="12" Foreground="#ADB5BD" Margin="0,20,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            <StackPanel x:Name="ConnectionToolsPanel"
                                        Visibility="Collapsed"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,22,0,0">
                                <Button Content="{DynamicResource Commissioning.ConnectButton}"
                                        Padding="12,6"
                                        Click="ConnectSolar_Click"/>
                                <Button Content="{DynamicResource Diagnostics.OpenWindow}"
                                        Padding="12,6"
                                        Margin="8,0,0,0"
                                        Click="OpenDiagnostics_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="White" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Status.Database}" Foreground="#6C757D" FontSize="10" Margin="0,0,4,0"/>
                        <TextBlock x:Name="DatabasePathText"
                                   Foreground="#6C757D"
                                   FontSize="10"
                                   MaxWidth="520"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0">
                        <ProgressBar x:Name="GlobalOperationProgressBar"
                                     Width="70"
                                     Height="8"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed"
                                     Margin="0,0,7,0"/>
                        <TextBlock x:Name="GlobalOperationStatusText"
                                   VerticalAlignment="Center"
                                   Foreground="#495057"
                                   FontSize="10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="VersionBuildText"
                                   Foreground="#495057"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="0,0,12,0"/>
                        <TextBlock Foreground="#6C757D"
                                   FontSize="10"
                                   Text="{DynamicResource Status.SpecFrozen}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
