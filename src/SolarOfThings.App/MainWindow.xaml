                                           FontSize="13"
                                           Foreground="#6C757D"/>
                                <TextBlock x:Name="ConfigurationHealthText"
                                           Text="{DynamicResource Data.ConfigurationUnresolved}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#343A40"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"/>
                                <TextBlock x:Name="ConfigurationHealthDetailText"
                                           Text=""
                                           FontSize="12"
                                           Foreground="#6C757D"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>


                <ScrollViewer x:Name="ReportsContent"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PageScrollViewer_PreviewMouseWheel">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource Reports.Heading}"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="#343A40"/>
                        <TextBlock Text="{DynamicResource Reports.Intro}"
                                   FontSize="13"
                                   Foreground="#6C757D"
                                   Margin="0,5,0,16"
                                   TextWrapping="Wrap"/>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Reports.PeriodHeading}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,14,10">
                                        <TextBlock Text="{DynamicResource Reports.ReportName}"
                                                   Foreground="#6C757D"
                                                   FontSize="12"/>
                                        <TextBox x:Name="ReportTitleTextBox"
                                                 Width="260"
                                                 MinHeight="28"
                                                 VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,10">
                                        <TextBlock Text="{DynamicResource Reports.Type}"
                                                   Foreground="#6C757D"
                                                   FontSize="12"/>
                                        <ComboBox x:Name="ReportTypeSelector"
                                                  Width="190"
                                                  SelectedValuePath="Tag"
                                                  SelectionChanged="ReportTypeSelector_SelectionChanged">
                                            <ComboBoxItem Tag="SimpleEnergy" Content="{DynamicResource Reports.Type.Simple}"/>
                                            <ComboBoxItem Tag="DetailedEnergy" Content="{DynamicResource Reports.Type.Detailed}"/>
                                            <ComboBoxItem Tag="Battery" Content="{DynamicResource Reports.Type.Battery}"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,10">
                                        <TextBlock Text="{DynamicResource Reports.QuickRange}"
                                                   Foreground="#6C757D"
                                                   FontSize="12"/>
                                        <ComboBox x:Name="ReportRangePresetSelector"
                                                  Width="230"
                                                  SelectedValuePath="Tag"
                                                  SelectionChanged="ReportRangePresetSelector_SelectionChanged">
                                            <ComboBoxItem Tag="all" Content="{DynamicResource Reports.Range.All}"/>
                                            <ComboBoxItem Tag="latest-day" Content="{DynamicResource Reports.Range.LatestDay}"/>
                                            <ComboBoxItem Tag="rolling-7" Content="{DynamicResource Reports.Range.Rolling7}"/>
                                            <ComboBoxItem Tag="latest-month" Content="{DynamicResource Reports.Range.LatestMonth}"/>
                                            <ComboBoxItem Tag="last-3-complete-months" Content="{DynamicResource Reports.Range.Last3CompleteMonths}"/>
                                            <ComboBoxItem Tag="rolling-12-months" Content="{DynamicResource Reports.Range.Rolling12Months}"/>
                                            <ComboBoxItem Tag="year-to-date" Content="{DynamicResource Reports.Range.YearToDate}"/>
                                            <ComboBoxItem Tag="custom" Content="{DynamicResource Reports.Range.Custom}"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,10">
                                        <TextBlock Text="{DynamicResource Analysis.From}"
                                                   Foreground="#6C757D"
                                                   FontSize="12"/>
                                        <DatePicker x:Name="ReportFromDatePicker"
                                                    Width="190"
                                                    SelectedDateChanged="ReportDatePicker_SelectedDateChanged"/>
                                        <WrapPanel Margin="0,4,0,0">
                                            <ComboBox x:Name="ReportFromMonthSelector"
                                                      Width="108"
                                                      DisplayMemberPath="Value"
                                                      SelectedValuePath="Key"
                                                      ToolTip="{DynamicResource Reports.Month}"
                                                      SelectionChanged="ReportDatePartSelector_SelectionChanged"/>
                                            <ComboBox x:Name="ReportFromYearSelector"
                                                      Width="76"
                                                      Margin="6,0,0,0"
                                                      ToolTip="{DynamicResource Reports.Year}"
                                                      SelectionChanged="ReportDatePartSelector_SelectionChanged"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,10">
                                        <TextBlock Text="{DynamicResource Analysis.To}"
                                                   Foreground="#6C757D"
                                                   FontSize="12"/>
                                        <DatePicker x:Name="ReportToDatePicker"
                                                    Width="190"
                                                    SelectedDateChanged="ReportDatePicker_SelectedDateChanged"/>
                                        <WrapPanel Margin="0,4,0,0">
                                            <ComboBox x:Name="ReportToMonthSelector"
                                                      Width="108"
                                                      DisplayMemberPath="Value"
                                                      SelectedValuePath="Key"
                                                      ToolTip="{DynamicResource Reports.Month}"
                                                      SelectionChanged="ReportDatePartSelector_SelectionChanged"/>
                                            <ComboBox x:Name="ReportToYearSelector"
                                                      Width="76"
                                                      Margin="6,0,0,0"
                                                      ToolTip="{DynamicResource Reports.Year}"
                                                      SelectionChanged="ReportDatePartSelector_SelectionChanged"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,10">
                                        <TextBlock Text="{DynamicResource Analysis.Aggregation}"
                                                   Foreground="#6C757D"
                                                   FontSize="12"/>
                                        <ComboBox x:Name="ReportAggregationSelector"
                                                  Width="150"
                                                  SelectedValuePath="Tag"
                                                  SelectionChanged="ReportAggregationSelector_SelectionChanged">
                                            <ComboBoxItem Tag="Day" Content="{DynamicResource Analysis.Aggregation.Day}"/>
                                            <ComboBoxItem Tag="Week" Content="{DynamicResource Analysis.Aggregation.Week}"/>
                                            <ComboBoxItem Tag="Month" Content="{DynamicResource Analysis.Aggregation.Month}"/>
                                            <ComboBoxItem Tag="Year" Content="{DynamicResource Analysis.Aggregation.Year}"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <Button Content="{DynamicResource Reports.UpdateSelection}"
                                            Padding="12,6"
                                            Margin="0,17,0,10"
                                            Click="ReportRefreshSelection_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="ReportSelectionSummaryText"
                                           FontSize="13"
                                           Foreground="#495057"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Reports.PresetsHeading}"
                                           FontSize="17"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Reports.PresetsIntro}"
                                           FontSize="12"
                                           Foreground="#6C757D"
                                           Margin="0,4,0,10"
                                           TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <TextBox x:Name="ReportPresetNameTextBox"
                                             Width="250"
                                             MinHeight="28"
                                             VerticalContentAlignment="Center"
                                             Margin="0,0,8,8"/>
                                    <Button Content="{DynamicResource Reports.SavePreset}"
                                            Padding="12,6"
                                            Margin="0,0,14,8"
                                            Click="ReportSavePreset_Click"/>
                                    <ComboBox x:Name="SavedReportPresetSelector"
                                              Width="250"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="SavedReportPresetSelector_SelectionChanged"
                                              Margin="0,0,8,8"/>
                                    <Button x:Name="ReportDeletePresetButton"
                                            Content="{DynamicResource Reports.DeletePreset}"
                                            Padding="12,6"
                                            IsEnabled="False"
                                            Margin="0,0,0,8"
                                            Click="ReportDeletePreset_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Reports.ExportHeading}"
                                           FontSize="17"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Reports.ExportIntro}"
                                           FontSize="12"
                                           Foreground="#6C757D"
                                           Margin="0,4,0,12"
                                           TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ReportExportExcelButton"
                                            Content="{DynamicResource Reports.ExportExcel}"
                                            Padding="14,7"
                                            Click="ReportExportExcel_Click"/>
                                    <Button x:Name="ReportExportPdfButton"
                                            Content="{DynamicResource Reports.ExportPdf}"
                                            Padding="14,7"
                                            Margin="8,0,0,0"
                                            Click="ReportExportPdf_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="ReportExportProgressLabel"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#495057"
                                           Margin="0,12,0,4"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                                <ProgressBar x:Name="ReportExportProgressBar"
                                             Height="16"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"
                                             Visibility="Collapsed"/>
                                <TextBlock x:Name="ReportStatusText"
                                           FontSize="12"
                                           Foreground="#6C757D"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PageScrollViewer_PreviewMouseWheel">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource Settings.Heading}" FontSize="21" FontWeight="SemiBold" Foreground="#343A40"/>
                        <TextBlock Text="{DynamicResource Settings.Intro}" FontSize="13" Foreground="#6C757D" Margin="0,5,0,16" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource CardStyle}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings.ConnectionHeading}" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SettingsSessionStatusText" Text="{DynamicResource Settings.SessionNotRemembered}" FontSize="13" FontWeight="SemiBold" Foreground="#6C757D" Margin="0,8,0,12" TextWrapping="Wrap"/>
                                <CheckBox x:Name="AutoConnectCheckBox" Content="{DynamicResource Settings.AutoConnect}" Click="AutoConnectCheckBox_Click"/>
                                <TextBlock Text="{DynamicResource Settings.AutoConnectHint}" FontSize="12" Foreground="#6C757D" Margin="22,4,0,14" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{DynamicResource Commissioning.ConnectButton}" Padding="12,6" Click="SettingsConnect_Click"/>
                                    <Button Content="{DynamicResource Settings.ForgetCredentials}" Padding="12,6" Margin="8,0,0,0" Click="SettingsForgetSession_Click"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Settings.PasswordPrivacy}" FontSize="11" Foreground="#6C757D" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="PlaceholderContent" Visibility="Collapsed" Margin="20">
                    <Border Style="{StaticResource CardStyle}" Margin="0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
                            <TextBlock Text="{DynamicResource Placeholder.Heading}" FontSize="13" Foreground="#6C757D" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PlaceholderTitle" FontSize="26" FontWeight="SemiBold" Foreground="#343A40" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PlaceholderDescription" FontSize="14" Foreground="#6C757D" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Placeholder.NoFakeData}" FontSize="12" Foreground="#ADB5BD" Margin="0,20,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            <StackPanel x:Name="ConnectionToolsPanel"
                                        Visibility="Collapsed"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,22,0,0">
                                <Button Content="{DynamicResource Commissioning.ConnectButton}"
                                        Padding="12,6"
                                        Click="ConnectSolar_Click"/>
                                <Button Content="{DynamicResource Diagnostics.OpenWindow}"
                                        Padding="12,6"
                                        Margin="8,0,0,0"
                                        Click="OpenDiagnostics_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="White" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Status.Database}" Foreground="#6C757D" FontSize="10" Margin="0,0,4,0"/>
                        <TextBlock x:Name="DatabasePathText"
                                   Foreground="#6C757D"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="#6C757D"
                               FontSize="10"
                               Text="{DynamicResource Status.SpecFrozen}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
