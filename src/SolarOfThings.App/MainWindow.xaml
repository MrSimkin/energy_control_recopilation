<Window x:Class="SolarOfThings.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solar Energy Monitor"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#C2C7D0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F474E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#343A40">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#2B3035" Padding="16">
                    <StackPanel>
                        <TextBlock Text="SOLAR ENERGY" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Home Monitor" Foreground="#ADB5BD" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,12,0,0">
                    <Button Style="{StaticResource SidebarButtonStyle}" Background="#007BFF" Foreground="White" Content="Dashboard"/>
                    <Button Style="{StaticResource SidebarButtonStyle}" Content="Analysis"/>
                    <Button Style="{StaticResource SidebarButtonStyle}" Content="Battery"/>
                    <Button Style="{StaticResource SidebarButtonStyle}" Content="Grid &amp; Utility"/>
                    <Button Style="{StaticResource SidebarButtonStyle}" Content="Reports"/>
                    <Button Style="{StaticResource SidebarButtonStyle}" Content="Data"/>
                    <Button Style="{StaticResource SidebarButtonStyle}" Content="Advanced / Diagnostics"/>
                    <Button Style="{StaticResource SidebarButtonStyle}" Content="Settings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Dashboard" FontSize="18" FontWeight="SemiBold" Foreground="#343A40"/>
                        <TextBlock Text="Local-first Solar of Things energy analysis" FontSize="11" Foreground="#6C757D"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Padding="18,8"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Background="#28A745"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="UpdateData_Click"
                            Content="Update Data"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Overview" FontSize="21" FontWeight="SemiBold" Foreground="#343A40" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" BorderBrush="#17A2B8" BorderThickness="4,1,1,1">
                            <StackPanel>
                                <TextBlock Text="PV POWER" Foreground="#6C757D" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="— kW" Foreground="#343A40" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                                <TextBlock Text="Awaiting first synchronization" Foreground="#ADB5BD" FontSize="11" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" BorderBrush="#28A745" BorderThickness="4,1,1,1">
                            <StackPanel>
                                <TextBlock Text="HOUSE LOAD" Foreground="#6C757D" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="— kW" Foreground="#343A40" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                                <TextBlock Text="Awaiting first synchronization" Foreground="#ADB5BD" FontSize="11" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" BorderBrush="#FFC107" BorderThickness="4,1,1,1">
                            <StackPanel>
                                <TextBlock Text="BATTERY SOC" Foreground="#6C757D" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="— %" Foreground="#343A40" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                                <TextBlock Text="11.776 kWh configured capacity" Foreground="#ADB5BD" FontSize="11" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="0" BorderBrush="#6C757D" BorderThickness="4,1,1,1">
                            <StackPanel>
                                <TextBlock Text="GRID IMPORT" Foreground="#6C757D" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="— kW" Foreground="#343A40" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                                <TextBlock Text="Awaiting first synchronization" Foreground="#ADB5BD" FontSize="11" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                            <StackPanel>
                                <Border BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="16,12">
                                    <TextBlock Text="Energy Overview" FontSize="15" FontWeight="SemiBold" Foreground="#343A40"/>
                                </Border>
                                <Grid Height="320">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Interactive chart area" FontSize="18" Foreground="#6C757D" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Charting is added after real telemetry and normalization are proven."
                                                   Margin="0,8,0,0"
                                                   Foreground="#ADB5BD"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   MaxWidth="430"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0" Padding="0">
                            <StackPanel>
                                <Border BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="16,12">
                                    <TextBlock Text="System Status" FontSize="15" FontWeight="SemiBold" Foreground="#343A40"/>
                                </Border>
                                <StackPanel Margin="16">
                                    <TextBlock Text="Solar of Things" Foreground="#6C757D"/>
                                    <TextBlock Text="Not connected yet" FontWeight="SemiBold" Foreground="#DC3545" Margin="0,2,0,14"/>
                                    <TextBlock Text="Local database" Foreground="#6C757D"/>
                                    <TextBlock Text="Ready" FontWeight="SemiBold" Foreground="#28A745" Margin="0,2,0,14"/>
                                    <TextBlock Text="Last update" Foreground="#6C757D"/>
                                    <TextBlock x:Name="LastUpdatedText" Text="Never" FontWeight="SemiBold" Foreground="#343A40" Margin="0,2,0,14"/>
                                    <TextBlock Text="Phase" Foreground="#6C757D"/>
                                    <TextBlock Text="1 — Technical Skeleton" FontWeight="SemiBold" Foreground="#343A40" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="White" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DatabasePathText"
                               VerticalAlignment="Center"
                               Foreground="#6C757D"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="#6C757D"
                               FontSize="10"
                               Text="Specification v1 frozen"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
