<Window x:Class="SolarOfThings.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:controls="clr-namespace:SolarOfThings.App.Controls"
        Title="{DynamicResource Window.Title}"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#C2C7D0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F474E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="LiveCountdownStyle" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="2"/>
            <Setter Property="Background" Value="#E9ECEF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Background="{TemplateBinding Background}"
                              ClipToBounds="True">
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#343A40">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#2B3035" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Brand.Title}" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Brand.Subtitle}" Foreground="#ADB5BD" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,12,0,0">
                    <Button x:Name="DashboardNav" Style="{StaticResource SidebarButtonStyle}" Tag="Dashboard" Click="Navigation_Click" Content="{DynamicResource Nav.Dashboard}"/>
                    <Button x:Name="AnalysisNav" Style="{StaticResource SidebarButtonStyle}" Tag="Analysis" Click="Navigation_Click" Content="{DynamicResource Nav.Analysis}"/>
                    <Button x:Name="BatteryNav" Style="{StaticResource SidebarButtonStyle}" Tag="Battery" Click="Navigation_Click" Content="{DynamicResource Nav.Battery}"/>
                    <Button x:Name="GridUtilityNav" Style="{StaticResource SidebarButtonStyle}" Tag="GridUtility" Click="Navigation_Click" Content="{DynamicResource Nav.GridUtility}"/>
                    <Button x:Name="ReportsNav" Style="{StaticResource SidebarButtonStyle}" Tag="Reports" Click="Navigation_Click" Content="{DynamicResource Nav.Reports}"/>
                    <Button x:Name="DataNav" Style="{StaticResource SidebarButtonStyle}" Tag="Data" Click="Navigation_Click" Content="{DynamicResource Nav.Data}"/>
                    <Button x:Name="DiagnosticsNav" Style="{StaticResource SidebarButtonStyle}" Tag="Diagnostics" Click="Navigation_Click" Content="{DynamicResource Nav.Diagnostics}"/>
                    <Button x:Name="SettingsNav" Style="{StaticResource SidebarButtonStyle}" Tag="Settings" Click="Navigation_Click" Content="{DynamicResource Nav.Settings}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="{DynamicResource Page.Dashboard.Title}" FontSize="18" FontWeight="SemiBold" Foreground="#343A40"/>
                        <TextBlock x:Name="PageSubtitle" Text="{DynamicResource Page.Dashboard.Subtitle}" FontSize="11" Foreground="#6C757D"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{DynamicResource Language.Label}" VerticalAlignment="Center" Foreground="#6C757D" Margin="0,0,8,0"/>
                        <ComboBox x:Name="LanguageSelector"
                                  Width="105"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="LanguageSelector_SelectionChanged">
                            <ComboBoxItem Tag="es" Content="{DynamicResource Language.Spanish}"/>
                            <ComboBoxItem Tag="en" Content="{DynamicResource Language.English}"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Padding="18,8"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Background="#28A745"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="{DynamicResource Tooltip.UpdateData}"
                            Click="UpdateData_Click"
                            Content="{DynamicResource Action.UpdateData}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="DashboardContent" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PageScrollViewer_PreviewMouseWheel">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource Dashboard.Overview}" FontSize="21" FontWeight="SemiBold" Foreground="#343A40"/>
                        <TextBlock x:Name="DashboardFreshnessText"
                                   Text=""
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#6C757D"
                                   Margin="0,4,0,14"
                                   TextWrapping="Wrap"/>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" BorderBrush="#17A2B8" BorderThickness="4,1,1,1" ToolTip="{DynamicResource Tooltip.PvPower}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="{DynamicResource Metric.PvPower}" Foreground="#6C757D" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="PvPowerValueText" Text="— kW" Foreground="#343A40" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="PvPowerMetaText" Text="{DynamicResource Metric.AwaitingSync}" Foreground="#6C757D" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="PvLiveCountdown"
                                                 Grid.Row="1"
                                                 Style="{StaticResource LiveCountdownStyle}"
                                                 Foreground="#17A2B8"
                                                 Margin="-18,12,-18,-18"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" BorderBrush="#28A745" BorderThickness="4,1,1,1" ToolTip="{DynamicResource Tooltip.HouseLoad}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="{DynamicResource Metric.HouseLoad}" Foreground="#6C757D" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="HouseLoadValueText" Text="— kW" Foreground="#343A40" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="HouseLoadMetaText" Text="{DynamicResource Metric.AwaitingSync}" Foreground="#6C757D" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="HouseLiveCountdown"
                                                 Grid.Row="1"
                                                 Style="{StaticResource LiveCountdownStyle}"
                                                 Foreground="#28A745"
                                                 Margin="-18,12,-18,-18"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" BorderBrush="#FFC107" BorderThickness="4,1,1,1" ToolTip="{DynamicResource Tooltip.BatterySoc}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="{DynamicResource Metric.BatterySoc}" Foreground="#6C757D" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="BatterySocValueText" Text="— %" Foreground="#343A40" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="BatterySocMetaText" Text="{DynamicResource Metric.ConfiguredCapacity}" Foreground="#6C757D" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="BatteryLiveCountdown"
                                                 Grid.Row="1"
                                                 Style="{StaticResource LiveCountdownStyle}"
                                                 Foreground="#FFC107"
                                                 Margin="-18,12,-18,-18"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="0" BorderBrush="#6C757D" BorderThickness="4,1,1,1" ToolTip="{DynamicResource Tooltip.GridImport}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="{DynamicResource Metric.GridImport}" Foreground="#6C757D" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="GridImportValueText" Text="— kW" Foreground="#343A40" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="GridImportMetaText" Text="{DynamicResource Metric.AwaitingSync}" Foreground="#6C757D" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="GridLiveCountdown"
                                                 Grid.Row="1"
                                                 Style="{StaticResource LiveCountdownStyle}"
                                                 Foreground="#6C757D"
                                                 Margin="-18,12,-18,-18"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                                <StackPanel>
                                    <Border BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="16,12">
                                        <TextBlock Text="{DynamicResource Dashboard.EnergyOverview}" FontSize="15" FontWeight="SemiBold" Foreground="#343A40"/>
                                    </Border>
                                    <Border Background="#F8F9FA"
                                            BorderBrush="#DEE2E6"
                                            BorderThickness="0,0,0,1"
                                            Padding="16,12">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Dashboard.OperatingState}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#6C757D"/>
                                            <TextBlock x:Name="OperatingStateText"
                                                       Text="{DynamicResource Operating.NO_DATA}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="#343A40"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0"/>
                                            <TextBlock x:Name="OperatingStateMetaText"
                                                       Text=""
                                                       FontSize="11"
                                                       Foreground="#6C757D"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Margin="16"
                                                ToolTip="{DynamicResource Tooltip.DashboardLatestDay}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource Dashboard.LatestDayHeading}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Foreground="#343A40"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Content="{DynamicResource Dashboard.OpenHistory}"
                                                    Tag="Analysis"
                                                    Padding="10,5"
                                                    Margin="12,0,0,0"
                                                    Click="Navigation_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="DashboardLatestDayDateText"
                                                   Text="{DynamicResource Dashboard.LatestDayNoData}"
                                                   FontSize="12"
                                                   Foreground="#6C757D"
                                                   Margin="0,4,0,12"
                                                   TextWrapping="Wrap"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{DynamicResource Dashboard.LatestDaySolar}"
                                                           FontSize="12"
                                                           Foreground="#6C757D"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock x:Name="DashboardLatestDaySolarText"
                                                           Text="— kWh"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Text="{DynamicResource Dashboard.LatestDayHouse}"
                                                           FontSize="12"
                                                           Foreground="#6C757D"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock x:Name="DashboardLatestDayHouseText"
                                                           Text="— kWh"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                                <TextBlock Text="{DynamicResource Dashboard.LatestDayGrid}"
                                                           FontSize="12"
                                                           Foreground="#6C757D"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock x:Name="DashboardLatestDayGridText"
                                                           Text="— kWh"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="{DynamicResource Dashboard.LatestDayCoverage}"
                                                           FontSize="12"
                                                           Foreground="#6C757D"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock x:Name="DashboardLatestDayCoverageText"
                                                           Text="— %"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0" Padding="0">
                                <StackPanel>
                                    <Border BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="16,12">
                                        <TextBlock Text="{DynamicResource Dashboard.SystemStatus}" FontSize="15" FontWeight="SemiBold" Foreground="#343A40"/>
                                    </Border>
                                    <StackPanel Margin="16">
                                        <TextBlock Text="{DynamicResource Status.SolarOfThings}" Foreground="#6C757D"/>
                                        <TextBlock x:Name="SolarStatusText" Text="{DynamicResource Status.NotConnected}" FontWeight="SemiBold" Foreground="#DC3545" Margin="0,2,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <Button Content="{DynamicResource Commissioning.ConnectButton}"
                                                    Padding="10,5"
                                                    HorizontalAlignment="Left"
                                                    Click="ConnectSolar_Click"/>
                                            <Button Content="{DynamicResource Dashboard.RefreshCurrent}"
                                                    ToolTip="{DynamicResource Tooltip.DashboardRefreshCurrent}"
                                                    Padding="10,5"
                                                    Margin="8,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    Click="RefreshCurrentState_Click"/>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource Status.LocalDatabase}" Foreground="#6C757D"/>
                                        <TextBlock Text="{DynamicResource Status.Ready}" FontWeight="SemiBold" Foreground="#28A745" Margin="0,2,0,14"/>
                                        <TextBlock Text="{DynamicResource Status.LastUpdate}" Foreground="#6C757D"/>
                                        <TextBlock x:Name="LastUpdatedText" Text="{DynamicResource Status.Never}" FontWeight="SemiBold" Foreground="#343A40" Margin="0,2,0,10"/>

                                        <TextBlock Text="{DynamicResource DataSync.StartModeLabel}" Foreground="#6C757D"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                            <ComboBox x:Name="CaptureStartModeSelector"
                                                      Width="190"
                                                      ToolTip="{DynamicResource Tooltip.CaptureStart}"
                                                      SelectedValuePath="Tag"
                                                      SelectionChanged="CaptureStartModeSelector_SelectionChanged">
                                                <ComboBoxItem Tag="auto" Content="{DynamicResource DataSync.StartModeAuto}"/>
                                                <ComboBoxItem Tag="manual" Content="{DynamicResource DataSync.StartModeManual}"/>
                                            </ComboBox>
                                            <controls:QuickDatePicker x:Name="ManualCaptureStartDatePicker"
                                                                      Width="150"
                                                                      ToolTip="{DynamicResource Tooltip.CaptureStart}"
                                                                      Margin="8,0,0,0"
                                                                      IsEnabled="False"/>
                                        </StackPanel>
                                        <TextBlock x:Name="CaptureStartHintText"
                                                   Foreground="#6C757D"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>

                                        <TextBlock x:Name="HistorySyncProgressLabel"
                                                   Text="{DynamicResource Status.SyncProgress}"
                                                   Foreground="#6C757D"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Visibility="Collapsed"/>
                                        <ProgressBar x:Name="HistorySyncProgressBar"
                                                     Height="18"
                                                     Minimum="0"
                                                     Maximum="1"
                                                     Value="0"
                                                     Margin="0,4,0,6"
                                                     Visibility="Collapsed"/>
                                        <TextBlock x:Name="HistorySyncProgressText"
                                                   Foreground="#495057"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Visibility="Collapsed"/>
                                        <Button x:Name="StopHistorySyncButton"
                                                Content="{DynamicResource Action.StopSync}"
                                                ToolTip="{DynamicResource Tooltip.StopSync}"
                                                Padding="10,5"
                                                Margin="0,7,0,14"
                                                HorizontalAlignment="Left"
                                                Visibility="Collapsed"
                                                Click="StopHistorySync_Click"/>

                                        <TextBlock Text="{DynamicResource Status.Phase}" Foreground="#6C757D"/>
                                        <TextBlock Text="{DynamicResource Status.Phase6}" FontWeight="SemiBold" Foreground="#343A40" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AnalysisContent"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PageScrollViewer_PreviewMouseWheel">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource Analysis.Heading}"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="#343A40"/>
                        <TextBlock Text="{DynamicResource Analysis.Intro}"
                                   FontSize="13"
                                   Foreground="#6C757D"
                                   Margin="0,5,0,16"
                                   TextWrapping="Wrap"/>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,10">
                                    <TextBlock Text="{DynamicResource Analysis.QuickRange}"
                                               VerticalAlignment="Center"
                                               Foreground="#6C757D"
                                               FontSize="13"
                                               Margin="0,0,8,0"/>
                                    <ComboBox x:Name="AnalysisRangePresetSelector"
                                              Width="245"
                                              SelectedValuePath="Tag"
                                              SelectionChanged="AnalysisRangePresetSelector_SelectionChanged">
                                        <ComboBoxItem Tag="all"
                                                      Content="{DynamicResource Analysis.Range.All}"/>
                                        <ComboBoxItem Tag="latest-day"
                                                      Content="{DynamicResource Analysis.Range.LatestDay}"/>
                                        <ComboBoxItem Tag="rolling-7"
                                                      Content="{DynamicResource Analysis.Range.Rolling7}"/>
                                        <ComboBoxItem Tag="latest-week"
                                                      Content="{DynamicResource Analysis.Range.LatestWeek}"/>
                                        <ComboBoxItem Tag="latest-month"
                                                      Content="{DynamicResource Analysis.Range.LatestMonth}"/>
                                        <ComboBoxItem Tag="latest-year"
                                                      Content="{DynamicResource Analysis.Range.LatestYear}"/>
                                        <ComboBoxItem Tag="rolling-12-months"
                                                      Content="{DynamicResource Analysis.Range.Rolling12Months}"/>
                                        <ComboBoxItem Tag="custom"
                                                      Content="{DynamicResource Analysis.Range.Custom}"/>
                                    </ComboBox>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource Analysis.From}"
                                               VerticalAlignment="Center"
                                               Foreground="#6C757D"
                                               FontSize="13"
                                               Margin="0,0,8,0"/>
                                    <controls:QuickDatePicker x:Name="AnalysisFromDatePicker"
                                                              Grid.Column="1"
                                                              Width="150"
                                                              SelectedDateChanged="AnalysisDatePicker_SelectedDateChanged"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{DynamicResource Analysis.To}"
                                               VerticalAlignment="Center"
                                               Foreground="#6C757D"
                                               FontSize="13"
                                               Margin="18,0,8,0"/>
                                    <controls:QuickDatePicker x:Name="AnalysisToDatePicker"
                                                              Grid.Column="3"
                                                              Width="150"
                                                              SelectedDateChanged="AnalysisDatePicker_SelectedDateChanged"/>

                                    <Button Grid.Column="4"
                                            Content="{DynamicResource Analysis.Apply}"
                                            Padding="14,6"
                                            Margin="18,0,0,0"
                                            Click="AnalysisApply_Click"/>

                                    <TextBlock x:Name="AnalysisStatusText"
                                               Grid.Column="5"
                                               Margin="18,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="#6C757D"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource CardStyle}"
                                    ToolTip="{DynamicResource Tooltip.AnalysisCoverage}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Analysis.Coverage}"
                                               FontSize="13"
                                               Foreground="#6C757D"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="AnalysisCoverageText"
                                               Text="—"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Analysis.SolarTime}"
                                               FontSize="13"
                                               Foreground="#6C757D"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="AnalysisSolarTimeText"
                                               Text="—"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Analysis.BatteryTime}"
                                               FontSize="13"
                                               Foreground="#6C757D"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="AnalysisBatteryTimeText"
                                               Text="—"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Analysis.GridTime}"
                                               FontSize="13"
                                               Foreground="#6C757D"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="AnalysisGridTimeText"
                                               Text="—"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="{DynamicResource Analysis.EnergyHeading}"
                                   FontSize="18"
