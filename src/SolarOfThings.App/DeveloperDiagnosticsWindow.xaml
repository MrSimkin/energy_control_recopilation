<Window x:Class="SolarOfThings.App.DeveloperDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Diagnostics.Title}"
        Width="1160"
        Height="820"
        MinWidth="900"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9"
        FontFamily="Consolas">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Diagnostics.Heading}" FontFamily="Segoe UI" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource Diagnostics.SecurityNotice}" FontFamily="Segoe UI" Foreground="#6C757D" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="{DynamicResource Diagnostics.InvestigationNotice}" FontFamily="Segoe UI" Foreground="#495057" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{DynamicResource Diagnostics.InvestigationHeading}" FontFamily="Segoe UI" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource Diagnostics.RemoteGroup}"
                           FontWeight="SemiBold" Foreground="#495057" Margin="0,0,0,5"/>
                <WrapPanel>
                    <Button x:Name="RunAllButton" Content="{DynamicResource Diagnostics.RunAll}" Padding="12,7" Margin="0,0,8,8" Click="RunAll_Click"/>
                    <Button x:Name="CaptureStateButton" Content="{DynamicResource Diagnostics.CaptureState}" Padding="12,7" Margin="0,0,8,8" Click="CaptureState_Click"/>
                    <Button x:Name="CaptureFlowButton" Content="{DynamicResource Diagnostics.CaptureFlow}" Padding="12,7" Margin="0,0,8,8" Click="CaptureFlow_Click"/>
                    <Button x:Name="ConfigCacheButton" Content="{DynamicResource Diagnostics.ConfigCache}" Padding="12,7" Margin="0,0,8,8" Click="ConfigCache_Click"/>
                    <Button x:Name="ConfigReadButton" Content="{DynamicResource Diagnostics.ConfigRead}" Padding="12,7" Margin="0,0,8,8" Click="ConfigRead_Click"/>
                    <Button x:Name="GridEnergyButton" Content="{DynamicResource Diagnostics.GridImportEnergy}" Padding="12,7" Margin="0,0,8,8" Click="GridEnergy_Click"/>
                </WrapPanel>
                <TextBlock Text="{DynamicResource Diagnostics.LocalGroup}"
                           FontWeight="SemiBold" Foreground="#495057" Margin="0,4,0,5"/>
                <WrapPanel>
                    <Button x:Name="PhaseEvidenceButton" Content="{DynamicResource Diagnostics.PhaseEvidence}" Padding="12,7" Margin="0,0,8,8" Click="PhaseEvidence_Click"/>
                    <Button x:Name="ExportBundleButton" Content="{DynamicResource Diagnostics.ExportBundle}" Padding="12,7" Margin="0,0,8,8" Click="ExportBundle_Click"/>
                    <Button x:Name="BackupButton" Content="{DynamicResource Diagnostics.OpenDataProtection}" Padding="12,7" Margin="0,0,8,8" Click="Backup_Click"/>
                </WrapPanel>
                <TextBlock Text="{DynamicResource Diagnostics.H01Intro}" TextWrapping="Wrap"
                           FontFamily="Segoe UI" Foreground="#495057" Margin="0,8,0,6"/>
                <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Diagnostics.H01From}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <DatePicker x:Name="H01FromPicker" Width="140" SelectedDateFormat="Short" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource Diagnostics.H01Through}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <DatePicker x:Name="H01ThroughPicker" Width="140" SelectedDateFormat="Short" Margin="0,0,12,0"/>
                    <Button x:Name="H01ExportButton" Content="{DynamicResource Diagnostics.H01Export}"
                            Padding="12,7" Click="H01Export_Click"/>
                </WrapPanel>
                <ProgressBar x:Name="DiagnosticsBusyBar"
                             Height="8"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             Margin="0,0,0,8"/>
                <TextBlock x:Name="ActionStatusText" FontFamily="Segoe UI" Foreground="#495057" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBox Grid.Row="2"
                 x:Name="ReportTextBox"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"/>

        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource Diagnostics.Refresh}" Padding="12,6" Margin="8,0,0,0" Click="Refresh_Click"/>
            <Button Content="{DynamicResource Diagnostics.CopyReport}" Padding="12,6" Margin="8,0,0,0" Click="Copy_Click"/>
            <Button Content="{DynamicResource Diagnostics.SaveReport}" Padding="12,6" Margin="8,0,0,0" Click="Save_Click"/>
            <Button Content="{DynamicResource Diagnostics.OpenLogs}" Padding="12,6" Margin="8,0,0,0" Click="OpenLogs_Click"/>
            <Button Content="{DynamicResource Common.Close}" Padding="12,6" Margin="8,0,0,0" Click="Close_Click"/>
        </WrapPanel>
    </Grid>
</Window>
