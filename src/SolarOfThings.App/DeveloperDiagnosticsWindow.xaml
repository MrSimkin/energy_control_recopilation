<Window x:Class="SolarOfThings.App.DeveloperDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Diagnostics.Title}"
        Width="1040"
        Height="760"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9"
        FontFamily="Consolas">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Diagnostics.Heading}" FontFamily="Segoe UI" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource Diagnostics.SecurityNotice}" FontFamily="Segoe UI" Foreground="#6C757D" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <TextBox Grid.Row="1"
                 x:Name="ReportTextBox"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" FontFamily="Segoe UI">
            <Button Content="{DynamicResource Diagnostics.Refresh}" Padding="12,6" Click="Refresh_Click"/>
            <Button Content="{DynamicResource Diagnostics.CopyReport}" Padding="12,6" Margin="8,0,0,0" Click="Copy_Click"/>
            <Button Content="{DynamicResource Diagnostics.SaveReport}" Padding="12,6" Margin="8,0,0,0" Click="Save_Click"/>
            <Button Content="{DynamicResource Diagnostics.OpenLogs}" Padding="12,6" Margin="8,0,0,0" Click="OpenLogs_Click"/>
            <Button Content="{DynamicResource Common.Close}" Padding="12,6" Margin="8,0,0,0" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
