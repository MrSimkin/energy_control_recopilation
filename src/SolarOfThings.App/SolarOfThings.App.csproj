<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>SolarEnergyMonitor</AssemblyName>
    <RootNamespace>SolarOfThings.App</RootNamespace>
    <VersionPrefix>0.10.0</VersionPrefix>
    <AssemblyVersion>0.10.0.0</AssemblyVersion>
    <FileVersion>0.10.0.0</FileVersion>
    <AppBuildNumber Condition="'$(AppBuildNumber)' == ''">local</AppBuildNumber>
    <AppSourceRevision Condition="'$(AppSourceRevision)' == ''">dev</AppSourceRevision>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>$(VersionPrefix)+build.$(AppBuildNumber).$(AppSourceRevision)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SolarOfThings.Core\SolarOfThings.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ScottPlot.WPF" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
