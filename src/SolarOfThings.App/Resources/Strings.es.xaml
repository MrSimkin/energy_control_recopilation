    <sys:String x:Key="Battery.TechnicalHeading">Información técnica</sys:String>
    <sys:String x:Key="Battery.TechnicalIntro">Detalles del inversor para revisión técnica. No son necesarios para el uso normal de la aplicación.</sys:String>
