<Window x:Class="SolarOfThings.App.CommissioningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Commissioning.Title}"
        Width="920"
        Height="760"
        MinWidth="820"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9"
        FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Commissioning.Heading}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource Commissioning.Intro}" TextWrapping="Wrap" Foreground="#6C757D" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="{DynamicResource Commissioning.Account}" FontWeight="SemiBold"/>
                    <TextBox x:Name="AccountTextBox" Margin="0,4,0,10" MinHeight="28"/>
                    <TextBlock Text="{DynamicResource Commissioning.Password}" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="PasswordInput" Margin="0,4,0,10" MinHeight="28"/>
                    <CheckBox x:Name="RememberCheckBox" Content="{DynamicResource Commissioning.Remember}" IsChecked="True"/>
                    <TextBlock Text="{DynamicResource Commissioning.TimeZone}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    <TextBox x:Name="TimeZoneTextBox" Text="America/Santiago" Margin="0,4,0,0" MinHeight="28"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Commissioning.SessionBootstrap}" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Commissioning.SessionBootstrapHint}" Foreground="#6C757D" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <TextBlock Text="{DynamicResource Commissioning.AccessToken}" FontSize="11"/>
                    <PasswordBox x:Name="AccessTokenInput" Margin="0,3,0,7" MinHeight="26"/>
                    <TextBlock Text="{DynamicResource Commissioning.RefreshToken}" FontSize="11"/>
                    <PasswordBox x:Name="RefreshTokenInput" Margin="0,3,0,7" MinHeight="26"/>
                    <Button Content="{DynamicResource Commissioning.UseTokens}"
                            HorizontalAlignment="Left"
                            Padding="12,6"
                            Click="UseTokenPair_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Expander Grid.Row="2"
                  Header="{DynamicResource Commissioning.ProtocolCredential}"
                  Margin="0,0,0,12">
            <Border Background="White" BorderBrush="#DEE2E6" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Commissioning.ProtocolCredentialHint}" TextWrapping="Wrap" Foreground="#6C757D"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="App ID" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="AppIdTextBox" MinHeight="27"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Commissioning.EncryptedSecret}" VerticalAlignment="Center"/>
                        <PasswordBox Grid.Column="1" x:Name="AppSecretInput" MinHeight="27"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{DynamicResource Commissioning.SaveProtocolCredential}"
                                Padding="12,6"
                                Click="SaveProtocolCredential_Click"/>
                        <Button Content="{DynamicResource Commissioning.ImportEnvironment}"
                                Padding="12,6"
                                Margin="8,0,0,0"
                                Click="ImportEnvironment_Click"/>
                        <Button Content="{DynamicResource Commissioning.UseDefaultProtocolCredential}"
                                Padding="12,6"
                                Margin="8,0,0,0"
                                Click="UseDefaultProtocolCredential_Click"/>
                        <TextBlock x:Name="ProtocolCredentialStatus"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#6C757D"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Expander>

        <Border Grid.Row="3" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="ConnectDiscoverButton"
                        Content="{DynamicResource Commissioning.ConnectDiscover}"
                        Padding="14,7"
                        Click="ConnectDiscover_Click"/>

                <ComboBox Grid.Column="1"
                          x:Name="StationComboBox"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Id"
                          Margin="10,0"
                          MinWidth="180"
                          SelectionChanged="StationComboBox_SelectionChanged"/>

                <TextBlock Grid.Column="2" Text="→" VerticalAlignment="Center"/>

                <ComboBox Grid.Column="3"
                          x:Name="DeviceComboBox"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Id"
                          Margin="10,0"
                          MinWidth="180"/>

                <Button Grid.Column="4"
                        x:Name="CommissionButton"
                        Content="{DynamicResource Commissioning.Run}"
                        Padding="14,7"
                        IsEnabled="False"
                        Click="Commission_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{DynamicResource Commissioning.Progress}"
                               FontWeight="SemiBold"
                               Padding="12"/>
                    <ListBox x:Name="ProgressListBox" Margin="8"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="4" Margin="6,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{DynamicResource Commissioning.Result}"
                               FontWeight="SemiBold"
                               Padding="12"/>
                    <TextBox x:Name="ResultTextBox"
                             Margin="8"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="True"/>
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Diagnostics.CopyReport}" Padding="12,6" Click="CopyReport_Click"/>
            <Button Content="{DynamicResource Diagnostics.OpenWindow}" Padding="12,6" Margin="8,0,0,0" Click="OpenDiagnostics_Click"/>
            <Button Content="{DynamicResource Commissioning.ForgetSession}" Padding="12,6" Margin="8,0,0,0" Click="ForgetSession_Click"/>
            <Button Content="{DynamicResource Common.Close}" Padding="12,6" Margin="8,0,0,0" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
